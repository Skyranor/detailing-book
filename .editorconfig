root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# В markdown концевые пробелы значимы только как перенос строки,
# а он в книге не используется: переносы делаются пустой строкой.
[*.md]
trim_trailing_whitespace = true
max_line_length = 80
